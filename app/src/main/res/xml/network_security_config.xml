<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP stays disabled everywhere except loopback, so the app can talk to
  a local OpenAI-compatible server (adb reverse tcp:8080 tcp:8080 for testing,
  or an on-device LLM) without weakening the default policy.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
